@startuml casos_de_uso
!theme plain
skinparam backgroundColor #FAFAFA
skinparam actorStyle awesome
skinparam packageStyle rectangle
title Selva Booking — Diagrama de casos de uso

left to right direction

actor "Cliente" as CLI
actor "Encargado\nde hotel" as ENC
actor "Administrador" as ADM
actor "SuperAdmin" as SA
actor "Firebase" as FB <<system>>
actor "Pasarela\nsimulada" as PAY <<system>>

rectangle "Sistema Selva Booking" {

  package "Autenticación" {
    usecase "Cerrar sesión" as UC04
    usecase "Completar perfil encargado" as UC05
    usecase "Alternar rol" as UC06
  }

  package "Cliente" {
    usecase "Explorar y buscar hoteles" as UC10
    usecase "Reservar y pagar" as UC11
    usecase "Mis reservas" as UC12
    usecase "Comentar hotel" as UC13
    usecase "Mi cuenta" as UC14
  }

  package "Encargado" {
    usecase "Gestionar mi hotel" as UC20
    usecase "Gestionar habitaciones\ne inventario" as UC21
    usecase "Historial de reservas" as UC22
    usecase "Ver comentarios" as UC23
  }

  package "Administrador limitado" {
    usecase "Panel de supervisión" as UC30
    usecase "Consultar hoteles" as UC31L
    usecase "Consultar reservas" as UC32L
    usecase "Gestionar encargados" as UC33L
  }

  package "SuperAdmin" {
    usecase "Panel global" as UC30S
    usecase "Gestionar hoteles\ny habitaciones" as UC31S
    usecase "Gestionar reservas" as UC32S
    usecase "Gestionar encargados" as UC33S
    usecase "Gestionar administradores" as UC34
    usecase "Auditoría" as UC35
    usecase "Comentarios por hotel" as UC36
  }

  usecase "Soporte y preguntas frecuentes" as UC99
}

CLI --> UC04
CLI --> UC10
CLI --> UC11
CLI --> UC12
CLI --> UC13
CLI --> UC14
CLI --> UC99

ENC --> UC04
ENC --> UC05
ENC --> UC06
ENC --> UC20
ENC --> UC21
ENC --> UC22
ENC --> UC23
ENC --> UC14
ENC --> UC99

ADM --> UC04
ADM --> UC06
ADM --> UC30
ADM --> UC31L
ADM --> UC32L
ADM --> UC33L
ADM --> UC14
ADM --> UC99

SA --> UC04
SA --> UC06
SA --> UC30S
SA --> UC31S
SA --> UC32S
SA --> UC33S
SA --> UC34
SA --> UC35
SA --> UC36
SA --> UC14
SA --> UC99

UC11 ..> PAY : <<incluye>>
UC11 ..> UC10 : <<extiende>>
UC23 ..> UC20 : <<extiende>>
UC36 ..> UC31S : <<extiende>>

@enduml
